# Токен Telegram-бота из @BotFather
BOT_TOKEN=

# Порт API-сервера
PORT=3000

# Dev-вход без Telegram (1 = вкл). В проде оставьте пустым/0.
ALLOW_DEV_AUTH=

# Telegram-id администраторов через запятую (для админки: правка любых профилей)
# Напр.: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Чат заявок с лендинга (форма «Заявка на личную встречу в клуб»).
# id группы (-100...) / канала / личный id. Бот должен быть в этой группе.
# Пусто → заявки уходят в ЛС всем из ADMIN_IDS.
APPLICATIONS_CHAT_ID=
# Бот для отправки заявок (должен состоять в чате выше). Пусто → BOT_TOKEN.
APPLICATIONS_BOT_TOKEN=

# Supabase (общая БД профилей). Если заданы — хранилище переключается на Supabase,
# иначе используется файловое (server/data/profiles.json).
# URL и SERVICE ROLE key берутся из Supabase → Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Мост к TradeJournal (server/src/tradejournal.ts) — данные для вкладки
# «Trade Journal» в этой админке. Секрет должен совпадать с ADMIN_API_SECRET
# в TradeJournal-проекте (~/Densays/TradeJournal/.env). Никогда не уходит в
# браузер — только этот сервер ходит к TradeJournal сервер-сервер.
TRADEJOURNAL_API_URL=
TRADEJOURNAL_ADMIN_API_SECRET=
